# کلیدهای Gemini — می‌توانید با کاما جدا کنید یا به صورت خط‌به‌خط (بین نقل‌قول) بنویسید
GEMINI_API_KEYS="
AIzaSy...
AIzaSy...
AIzaSy...
"

# کلید محافظتی سرور خودت (برای x-api-key در request ها)
# می‌تونی با این دستور بسازی: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# رمز ورود پنل وب ادمین (/admin)
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# اختیاری
PORT=8080
KEY_COOLDOWN_MS=60000
# DATA_DIR=./data
