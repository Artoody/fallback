{
  "name": "gemini-fallback-proxy",
  "version": "1.0.0",
  "description": "Proxy server with automatic API key rotation/fallback for Google Gemini API",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:codex": "node scripts/test-codex.js",
    "stress": "node test/stress.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2"
  }
}
